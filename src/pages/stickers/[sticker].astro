---
import { Image } from "astro:assets";
import Base from "$layouts/Base.astro";
import i18nit from "$i18n";
import config from "$config";

export async function getStaticPaths() {
	const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/stickers/*.{jpg,jpeg}", { eager: true });
	return Object.entries(images).map(([path, { default: image }]) => ({
		params: {
			sticker: path
				.split("/")
				.pop()!
				.replace(/\.(jpe?g)$/i, "")
		},
		props: { image }
	}));
}

const { sticker } = Astro.params;
// This route has no locale prefix — params only ever contains `sticker`
const locale = config.i18n.defaultLocale;
const { image } = Astro.props as { image: ImageMetadata };
const t = i18nit(locale);
const title = t("navigation.stickers") || sticker;
---

<Base title={title} {locale}>
  <main class="flex flex-col items-center justify-center min-h-screen">
    <h1>{ sticker }</h1>
    <Image src={image} alt={t('navigation.stickers', { sticker })} priority />
  </main>
</Base>
