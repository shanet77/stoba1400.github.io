---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import config from "$config";
import { localePaths } from "$utils/locale";
import Time from "$utils/time";
import Base from "$layouts/Base.astro";
import i18nit from "$i18n";

export async function getStaticPaths() {
	return localePaths();
}

const { locale = config.i18n.defaultLocale } = Astro.params;

const t = i18nit(locale);

const introduction = await getEntry("information", `${locale}/introduction`);

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/stickers/*.{jpg,jpeg}", { eager: true });
const stickers = Object.entries(images)
	.map(([path, { default: image }]) => ({
		name: path
			.split("/")
			.pop()!
			.replace(/\.(jpe?g)$/i, ""),
		image
	}))
	.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
---

<style lang="less">
	article {
		div {
			margin-bottom: 2rem;

			h1 {
				margin-bottom: 1rem;

				font-size: 1.8rem;
			}
		}
	}
  .gallery { display: flex; gap: 1rem; flex-wrap: wrap; }
  .gallery img { border: 1px solid #ddd; border-radius: 8px; }
</style>

<Base title={t("navigation.stickers")} {locale}>
	<main class="flex flex-col sm:flex-row justify-between gap-5">
		<article class="flex flex-col">
			{
				(
					<div>
						<h1>Stickers</h1>
						<div>
						<p>A collection of images that I like across the internet displayed here as stickers.</p>
						</div>
						<div class="gallery">
							{stickers.map(s => (
								<a href={`/stickers/${s.name}`} target="_blank">
									<Image src={s.image} alt={s.name} width={120} densities={[1, 2]} />
								</a>
							))}
            </div>
					</div>
				)
			}
		</article>
	</main>
</Base>
