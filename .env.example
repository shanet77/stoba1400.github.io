# Public runtime env vars (embedded at build time)
PUBLIC_TIMEZONE=America/Chicago

# Optional: set Umami website ID to enable analytics
# Example:
# PUBLIC_UMAMI_WEBSITE_ID=f84a92b0-dfb9-481b-85e1-9b3143061c91
PUBLIC_UMAMI_WEBSITE_ID=

# HoopNerd embed target for the /play page (defaults to https://hoopnerd.xyz)
# Example for local dev against a HoopNerd checkout:
# PUBLIC_HOOPNERD_EMBED_ORIGIN=http://localhost:3000
PUBLIC_HOOPNERD_EMBED_ORIGIN=
